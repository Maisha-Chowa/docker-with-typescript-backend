{
  "name": "ts-container",
  "image": "node:20",
  "workspaceFolder": "/app",
  "mounts": [
    "type=bind,source=/Users/maisha-chowa/Documents/koolio-office-task/docker-with-typescript-backend,target=/app",
    "type=volume,source=ts-docker-logs,target=/app/logs",
    "type=volume,target=/app/node_modules"
  ],
  "runArgs": [
    "--name",
    "ts-container",
    "-p",
    "5001:5001",
    "--rm",
    "--env-file",
